{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/1998x-stack/trajectory-analysis/blob/main/trajectory-format/schema/canonical-trajectory.schema.json",
  "title": "Example Canonical Agent Trajectory v0.1.0 (project-local, NOT an industry standard)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session_id",
    "events"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/event"
      }
    }
  },
  "$defs": {
    "event": {
      "type": "object",
      "required": [
        "event_id",
        "sequence",
        "timestamp",
        "actor",
        "event_type",
        "payload",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "parent_event_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "trace_id": {
          "type": "string"
        },
        "span_id": {
          "type": "string"
        },
        "parent_span_id": {
          "type": "string"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "actor": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "id"
          ],
          "properties": {
            "type": {
              "enum": [
                "user",
                "agent",
                "system",
                "tool",
                "environment"
              ]
            },
            "id": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "event_type": {
          "enum": [
            "message",
            "tool_call",
            "tool_result",
            "state_update",
            "checkpoint",
            "handoff",
            "error"
          ]
        },
        "tool_call_id": {
          "type": "string"
        },
        "payload": {
          "type": "object"
        },
        "source": {
          "type": "object",
          "required": [
            "format",
            "raw_ref"
          ],
          "additionalProperties": false,
          "properties": {
            "format": {
              "type": "string"
            },
            "raw_ref": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
